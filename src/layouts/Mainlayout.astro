---
import NavbarDesktop from '../components/NavbarDesktop.astro';

const { title = "BANKOLE FRANCES | Gospel Artist | Musician" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/x-icon" href="./images/favicon14.ico">
  <title>{title}</title>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="generator" content={Astro.generator} />
  <link rel="stylesheet" href="/styles/style.css" />
  <!--ANIMATE ON SCROLL CDN-->
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  <!--KURSOR CDN-->
  <link rel="stylesheet" href="https://unpkg.com/kursor/dist/kursor.css" />
  <!--ALPINE JS CDN-->
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <!-- Bootstrap CSS v5.3.8 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://kit.fontawesome.com/c200d965db.js" crossorigin="anonymous"></script>
<script src="/scripts/bankoleNav.js" is:inline></script>
</head>
<body id="body">
  <div x-data="{tab: 'tab1'}">
  <header>
      <NavbarDesktop />
  </header>
  <main><slot/></main>
  </div>



<!-- JAVASCRIPT SECTION -->

<!-- AUDIO SCRIPT -->

<script src="/scripts/bankoleAudio.js" is:inline></script>

<!-- TESTIMONIES SCRIPT -->

<script src="/scripts/bankoleTestimonies.js" is:inline></script>

  <!--ANIMATE ON SCROLL CDN & SCRIPT-->
<script src="https://unpkg.com/aos@next/dist/aos.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    AOS.init({
      duration: 1000,
      once: false,
      mirror: true,
      offset: 100
    });
  });

  // Refresh AOS on Alpine.js tab changes
  document.addEventListener('alpine:initialized', () => {
    AOS.refresh();
  });
</script>

<!--KURSOR.JS CDN & SCRIPT-->
<script src="https://cdn.jsdelivr.net/npm/kursor@0.1.6/dist/kursor.min.js"></script>
    <script>
      window.onload = () => {
        new kursor({
            type: 4,
            removeDefaultCursor: true,
            color: "#232123",
        });
      }
    </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>
  </body>
  </html>