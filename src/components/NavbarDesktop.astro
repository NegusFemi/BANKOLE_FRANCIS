---
---
<!-- STYLESHEET -->
<link rel="stylesheet" href="/styles/style.css" />

<!-- NAVIGATION -->
    <div class="container-fluid nav-container">
      <div class="row">
        <div class="col-12">
          <nav class="navbar">
            <a href="#" x-bind:href="tab==='tab1' ? '#tab1' : tab==='tab2' ? '#tab2' : tab==='tab3' ? '#tab3' " ><img src="/images/bf6.png" alt="corporate company logo" class="logo"></a>
            <span class="open-slide">
              <a href="#/" onclick="openSlideMenu()"><svg xmlns="http://www.w3.org/2000/svg" width="39" height="25" fill="currentColor" id="menuBtn" class="bi bi-list" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                   </svg><!--img src="./IMAGES/hamburgerpng.png" alt="hamburger icon" id="menuBtn"--></a>
            </span>
            <ul class="navbar-nav">
              <li><a href="#" x-bind:class="{'border-white': (tab==='tab1' && window.innerWidth >= 37.5 * 16), 'active-tab': (tab==='tab1' && window.innerWidth < 37.5 * 16)}" x-on:click="tab='tab1'">
                <span x-data="{tab: 'tab1'}" x-bind:class="{'break-word': window.innerWidth < 37.5 * 16}">
                  NOTHING BUT <br x-show="window.innerWidth < 37.5 * 16">
                  YOUR GRACE
                </span>
              </a></li>
              <li><a href="#" x-bind:class="{'border-white': (tab==='tab2' && window.innerWidth >= 37.5 * 16), 'active-tab': (tab==='tab2' && window.innerWidth < 37.5 * 16)}" x-on:click="tab='tab2'">
                <span x-data="{tab: 'tab2'}" x-bind:class="{'break-word': window.innerWidth < 37.5 * 16}">
                  WE LOVE <br x-show="window.innerWidth < 37.5 * 16">
                  YOUR NAME
                </span>
              </a></li>
              <li><a href="#" x-bind:class="{'border-white': (tab==='tab3' && window.innerWidth >= 37.5 * 16), 'active-tab': (tab==='tab3' && window.innerWidth < 37.5 * 16)}" x-on:click="tab='tab3'">
                <span x-data="{tab: 'tab3'}" x-bind:class="{'break-word': window.innerWidth < 37.5 * 16}">
                  CROWN HIM<br x-show="window.innerWidth < 37.5 * 16"> KING
                </span>
              </a></li>
              <style>
                .active-tab {
                  color: rgb(252, 254, 254);
                  background-color: #0b32350a;
                  border-radius: 0.4rem;
                  box-shadow: 0 15px 20px rgba(0, 0, 0, 0.2) !important;
                  border: 7px solid transparent rgb(255, 255, 255) !important;
                  padding: -2.2rem -2.05rem !important;
                  margin: -2rem 0 0 -2rem;
                }
              </style>
          </ul>
      </nav>
      <div id="side-menu" class="side-nav">
          <a href="#/" class="btn-close" onclick="closeSideMenu()"></a>
          <a href="#" x-bind:href="tab==='tab1' ? '#tab1' : tab==='tab2' ? '#tab2 : tab==='tab3' ? '#tab3" onclick="closeSideMenu()">HOME</a>
          <a href="#aboutUs" onclick="closeSideMenu()">ABOUT</a>
          <a href="#Gallery" onclick="closeSideMenu()">GALLERY</a>
          <a href="#testimonial-section" onclick="closeSideMenu()">TESTIMONIES</a>
          <a href="#blog-list" onclick="closeSideMenu()">EVENTS AND BLOG</a>
          <a href="#footer" onclick="closeSideMenu()">CONTACT</a>
          <div class="side-footer">
              <p>&copy;<span x-text="new Date().getFullYear()"></span></p>
              <p class = "elora">BANKOLE FRANCIS</p>
              <p>ALL RIGHTS RESERVED</p>
          </div>
        </div>
      </div>
    </div>
    <!-- NAVIGATION ENDS-->

    <!-- NAVIGATION SCRIPT -->
    <script src="/scripts/bankoleNav.js" is:inline></script>

    <!--script-- type="module" src=('../scripts/bankoleScript.js')></!--script-->
